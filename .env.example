# 复制本文件为 .env 并填入真实密钥（.env 已在 .gitignore 中，不会被提交）
# 优先级：系统环境变量 > .env 文件

AGENT_API_KEY=sk-xxxx

# 以下均为可选配置（示例为 DeepSeek）：
# AGENT_BASE_URL=https://api.deepseek.com/v1
# AGENT_MODEL=deepseek-chat
# AGENT_TEMPERATURE=0.2
# AGENT_LLM_TIMEOUT=60
# AGENT_MAX_LOOP_STEPS=5
# AGENT_MAX_HISTORY_TURNS=10
# AGENT_SESSION_FILE=data/sessions.json
